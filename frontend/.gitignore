# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files — ignored by default in case one is added later with real
# secrets. .env.development is the one deliberate exception: it holds no
# secret, just the local-only API URL override (see api.js) — Vite only
# loads it for `npm run dev`, never for the production build.
.env
.env.*
!.env.example
!.env.development

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
