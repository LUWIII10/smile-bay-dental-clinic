# Optional override for api.js's baseURL. You normally don't need this file:
# local dev already gets VITE_API_URL from the committed .env.development,
# and the production Docker build deliberately leaves it unset so the
# built frontend calls its own origin (Laravel serves both from one
# Railway service). Only add a real .env here if you need the frontend to
# call a DIFFERENT backend than either of those two cases.
VITE_API_URL=http://localhost:8000
